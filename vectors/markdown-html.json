{
  "description": "getHtmlFromMarkdown(text): escaped text with the supported markdown as HTML",
  "source": "reference renderer: markdown in text",
  "node": "22.22.2",
  "icu": "78.2",
  "cases": [
    {
      "input": {
        "text": "plain text"
      },
      "expected": "plain text"
    },
    {
      "input": {
        "text": "**bold**"
      },
      "expected": "<b>bold</b>"
    },
    {
      "input": {
        "text": "*italic*"
      },
      "expected": "<i>italic</i>"
    },
    {
      "input": {
        "text": "~strike~"
      },
      "expected": "<s>strike</s>"
    },
    {
      "input": {
        "text": "`code`"
      },
      "expected": "<span style='font-family: monospace'>code</span>"
    },
    {
      "input": {
        "text": "**bold** and *italic*"
      },
      "expected": "<b>bold</b> and <i>italic</i>"
    },
    {
      "input": {
        "text": "***both***"
      },
      "expected": "<b><i>both</b></i>"
    },
    {
      "input": {
        "text": "**unclosed"
      },
      "expected": "<i></i>unclosed"
    },
    {
      "input": {
        "text": "*a* *b*"
      },
      "expected": "<i>a</i> <i>b</i>"
    },
    {
      "input": {
        "text": "line one\\\nline two"
      },
      "expected": "line one<br/>line two"
    },
    {
      "input": {
        "text": "not a break\nnewline"
      },
      "expected": "not a break\nnewline"
    },
    {
      "input": {
        "text": "[Terms](https://example.com/terms)"
      },
      "expected": "<a href=\"https://example.com/terms\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>Terms</a>"
    },
    {
      "input": {
        "text": "[Mail](mailto:hi@example.com)"
      },
      "expected": "<a href=\"mailto:hi@example.com\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>Mail</a>"
    },
    {
      "input": {
        "text": "[Call](tel:+123)"
      },
      "expected": "<a href=\"tel:+123\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>Call</a>"
    },
    {
      "input": {
        "text": "[Rel](/pricing)"
      },
      "expected": "<a href=\"/pricing\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>Rel</a>"
    },
    {
      "input": {
        "text": "[Bad](javascript:alert(1))"
      },
      "expected": "Bad)"
    },
    {
      "input": {
        "text": "[Data](data:text/html,x)"
      },
      "expected": "Data"
    },
    {
      "input": {
        "text": "[Spaced]( javascript:x)"
      },
      "expected": "Spaced"
    },
    {
      "input": {
        "text": "<b>raw html</b>"
      },
      "expected": "&lt;b&gt;raw html&lt;/b&gt;"
    },
    {
      "input": {
        "text": "Tom & Jerry \"quoted\" 'single'"
      },
      "expected": "Tom &amp; Jerry &quot;quoted&quot; &#39;single&#39;"
    },
    {
      "input": {
        "text": "**[Link](https://a.b)**"
      },
      "expected": "<b><a href=\"https://a.b\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>Link</a></b>"
    },
    {
      "input": {
        "text": "[**bold link**](https://a.b)"
      },
      "expected": "<a href=\"https://a.b\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'><b>bold link</b></a>"
    },
    {
      "input": {
        "text": "a * b * c"
      },
      "expected": "a <i> b </i> c"
    },
    {
      "input": {
        "text": "2 ~ 3 ~ 4"
      },
      "expected": "2 <s> 3 </s> 4"
    },
    {
      "input": {
        "text": "`a` and `b`"
      },
      "expected": "<span style='font-family: monospace'>a</span> and <span style='font-family: monospace'>b</span>"
    },
    {
      "input": {
        "text": ""
      },
      "expected": ""
    },
    {
      "input": {
        "text": "Ünïcödé **✓** 🎉"
      },
      "expected": "Ünïcödé <b>✓</b> 🎉"
    },
    {
      "input": {
        "text": "[x](#anchor)"
      },
      "expected": "<a href=\"#anchor\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>x</a>"
    },
    {
      "input": {
        "text": "[x](?q=1)"
      },
      "expected": "<a href=\"?q=1\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>x</a>"
    },
    {
      "input": {
        "text": "[x](relative/path)"
      },
      "expected": "<a href=\"relative/path\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>x</a>"
    },
    {
      "input": {
        "text": "[x](HTTPS://UPPER.COM)"
      },
      "expected": "<a href=\"HTTPS://UPPER.COM\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>x</a>"
    },
    {
      "input": {
        "text": "[x](https://a.b?x=1&y=2)"
      },
      "expected": "<a href=\"https://a.b?x=1&amp;y=2\" target='_blank' rel='noopener noreferrer' style='color:inherit;text-decoration:none;'>x</a>"
    },
    {
      "input": {
        "text": "**multi\nline**"
      },
      "expected": "<i></i>multi\nline<i></i>"
    }
  ]
}
