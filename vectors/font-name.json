        "name": "Inter"
      },
      "expected": null
    },
    {
      "input": {
        "name": "Inter@70"
      },
      "expected": null
    },
    {
      "input": {
        "name": "Inter@7000"
      },
      "expected": null
    },
    {
      "input": {
        "name": "@400"
